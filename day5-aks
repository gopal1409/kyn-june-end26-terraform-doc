##first create a folder in your desktop called as aks
###create the provider file a1.provider.tf copy from the previous example
  terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "=4.1.0"
    }
  }
  backend "azurerm" {
    resource_group_name  = "gopal-storage1"
    storage_account_name = "terraformstoragego"
    container_name       = "tfstate"
    key                  = "sky-project-aks.tfstate" #change the key
  }
}

# Configure the Microsoft Azure Provider
provider "azurerm" {
  #resource_provider_registrations = "none" # This is only required when the User, Service Principal, or Identity running Terraform lacks the permissions to register Azure Resource Providers.
  features {}
}

######then create a2.variables.tf change the resource group name to your name
  variable "resource_group_name" {
  default = "rg-gopal-aks"
}

variable "location" {
  default = "East US"
}

variable "vnet_name" {
  default = "aks-vnet"
}
variable "subnet_name" {
  default = "aks-subnet"
}

variable "cluster_name" {
  default = "aks-cluster"
}
variable "dns_prefix" {
  default = "aksdns"
}

variable "node_count" {
  default = 2
}

variable "vm_size" {
  default = "Standard_DS2_v3"
}

variable "client_id" {
  default = "1.31"
}

##############################create a new file a3.resource-group.tf
  resource "azurerm_resource_group" "aks_rg" {
  name     = var.resource_group_name
  location = var.location
}

#############################create a new file a4.network.tf
  resource "azurerm_virtual_network" "aks_vnet" {
  name                = var.vnet_name
  location            = azurerm_resource_group.aks_rg.location
  resource_group_name = azurerm_resource_group.aks_rg.name
  address_space       = ["10.0.0.0/16"]
}

resource "azurerm_subnet" "aks_subnet" {
  name                 = var.subnet_name
  resource_group_name  = azurerm_resource_group.aks_rg.name
  virtual_network_name = azurerm_virtual_network.aks_vnet.name
  address_prefixes     = ["10.0.1.0/24"]
}

##################create teh aks cluster a4.aks.tf
  resource "azurerm_kubernetes_cluster" "aks_cluster" {
  name                = var.cluster_name
  location            = azurerm_resource_group.aks_rg.location
  resource_group_name = azurerm_resource_group.aks_rg.name
  dns_prefix          = var.dns_prefix

  default_node_pool {
    name       = "system"
    node_count = 2
    vm_size    = var.vm_size
  }

  identity {
    type = "SystemAssigned"
  }
  network_profile {
    network_plugin = "azure"
    load_balancer_sku = "standard"
  }
  tags = {
    Environment = "Production"
  }
}

##############then finally get the output create a new file output.tf
  output "cluster_name" {
   value = azurerm_kubernetes_cluster.aks_cluster.name
 }

 output "kube_config" {
   value = azurerm_kubernetes_cluster.aks_cluster.kube_config_raw
 }
 output "resource_group" {
   value = azurerm_resource_group.aks_rg.name
 }

##then do terraform init
  terraform plan
  terraform apply
  
