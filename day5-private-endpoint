#lets create a folder in desktop terraform-privatendpoint-open visual studio code and select the folder
  #inside that we will create a file a1.provider.tf copy the provider block from previous any example and change the key to a new key like we can put endpoint
  terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "=4.1.0"
    }
  }
  backend "azurerm" {
    resource_group_name  = "gopal-storage1"
    storage_account_name = "terraformstoragego"
    container_name       = "tfstate"
    key                  = "sky-project-endpoint.tfstate"
  }
}

# Configure the Microsoft Azure Provider
provider "azurerm" {
  #resource_provider_registrations = "none" # This is only required when the User, Service Principal, or Identity running Terraform lacks the permissions to register Azure Resource Providers.
  features {}
}

#lets create the a2.varaibles.tf
  variable "location" {
  description = "The location of the resources"
  type        = string
  default     = "East US"
}

variable "resource_group_name" {
  type = string
  default = "rg-gopal-endpoint" #replace the gopal to your name
}

variable "vnet_name" {
  type = string
  default = "demo-vnet"
}

variable "subnet_name" {
  type = string
  default = "demo-subnet"
}

variable "storage_account_name" {
  type = string
  default = "gopalterraformstorage14" #change this to your name
}

#now we need to create the resource group a3.rg.tf
  resource "azurerm_resource_group" "rg" {
  name     = var.resource_group_name
  location = var.location
}

##now we will create a4.network.tf
  resource "azurerm_virtual_network" "vnet" {
  name                = var.vnet_name
location            = azurerm_resource_group.rg.name
  resource_group_name = azurerm_resource_group.rg.name
  address_space       = ["10.0.0.0/16"]
}

resource "azurerm_subnet" "subnet" {
  name                 = var.subnet_name
  resource_group_name  = azurerm_resource_group.rg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.1.0/24"]
}

##we will create an storage account a5.storage.tf
  resource "random_string" "random" {
    length  = 5
    special = false
    upper  = false
}

resource "azurerm_storage_account" "storage" {
  name                     = "gopal${random_string.random.result}" #change this to your name
  resource_group_name      = azurerm_resource_group.rg.name
  location                 = azurerm_resource_group.rg.location
  account_tier             = "Standard"
  account_replication_type = "LRS"
  public_network_access_enabled = false
}



#now we will create the private dns a6.private dns zone
  resource "azurerm_private_dns_zone" "blob_dns" {
  name                = "privatelink.blob.core.windows.net"
  resource_group_name = azurerm_resource_group.rg.name
}
#we have an storage account we created a dns 
#now we need to link this DNS with whom
#link the dns zone
resource "azurerm_private_dns_zone_virtual_network_link" "link" {
  name                  = "storage-link"
  resource_group_name   = azurerm_resource_group.rg.name
  private_dns_zone_name = azurerm_private_dns_zone.blob_dns.name
  virtual_network_id    = azurerm_virtual_network.vnet.id
}


##finally we will add the private endpoint a7.private-endpoint.tf

  resource "azurerm_private_endpoint" "storage_pe" {

    name                = "storage-pe"
    location            = azurerm_resource_group.rg.location
    resource_group_name = azurerm_resource_group.rg.name
    subnet_id           = azurerm_subnet.subnet.id
    
    private_service_connection {
        name                           = "storage-connection"
        private_connection_resource_id = azurerm_storage_account.storage.id #we are attching the end point with storage account
        is_manual_connection          = false
        subresource_names             = ["blob"]
    }
    private_dns_zone_group {
        name                  = "default"
        private_dns_zone_ids  = [azurerm_private_dns_zone.blob_dns.id]
    }
}

#we need to output the private endpoint and storage account name also create a file output.tf
  output "private_endpoint_ip" {
  value = azurerm_private_endpoint.storage_pe.private_service_connection[0].private_ip_address
}

output "storage_account_name" {
  value = azurerm_storage_account.storage.name
}

#then do terraform init
  terraform plan
  terraform apply
  ##you will get the private ip and storage account name
  
